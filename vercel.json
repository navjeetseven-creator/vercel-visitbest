{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "cleanUrls": true,
  "outputDirectory": "dist",
  "ignoreCommand": "[ \"$VERCEL_ENV\" != \"production\" ]",
  "github": {
    "silent": true
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "destination": "/best-tea-brands-in-india/",
      "permanent": true,
      "source": "/best-tea-brand-in-india"
    },
    {
      "destination": "/best-tea-brands-in-india/",
      "permanent": true,
      "source": "/best-tea-brand-in-india/"
    },
    {
      "destination": "/earphones-under-2000/",
      "permanent": true,
      "source": "/best-earbuds-under-2000"
    },
    {
      "destination": "/earphones-under-2000/",
      "permanent": true,
      "source": "/best-earbuds-under-2000/"
    },
    {
      "destination": "/best-bluetooth-speakers-in-india/",
      "permanent": true,
      "source": "/best-bluetooth-speakers-under-2000"
    },
    {
      "destination": "/best-bluetooth-speakers-in-india/",
      "permanent": true,
      "source": "/best-bluetooth-speakers-under-2000/"
    }
  ],
  "trailingSlash": true
}
